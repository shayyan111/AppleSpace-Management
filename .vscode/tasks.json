{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AppleSpace: install dependencies",
      "type": "shell",
      "command": "npm ci",
      "windows": { "command": "npm.cmd ci" },
      "problemMatcher": []
    },
    {
      "label": "AppleSpace: start app",
      "type": "shell",
      "command": "npm run dev",
      "windows": { "command": "npm.cmd run dev" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "AppleSpace: build",
      "type": "shell",
      "command": "npm run build",
      "windows": { "command": "npm.cmd run build" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$tsc"]
    }
  ]
}
